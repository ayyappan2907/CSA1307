
#include <stdio.h>
#include <string.h>

int main()
{
    char s[100];
    int i, n, flag = 1;

    printf("Enter a binary string: ");
    scanf("%99s", s);

    n = strlen(s);

    for (i = 0; i < n; i++)
    {
        if (s[i] != '0' && s[i] != '1')
            flag = 0;
    }

    for (i = 0; i < n / 2; i++)
    {
        if (s[i] != s[n-1-i])
            flag = 0;
    }

    if (flag)
        printf("String Accepted");
    else
        printf("String Rejected");

    return 0;
}
