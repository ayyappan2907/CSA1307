
#include <stdio.h>
#include <string.h>

int main()
{
    char s[100];
    int i, j, valid = 1;

    printf("Enter a string: ");
    scanf("%99s", s);

    i = 0;
    j = strlen(s) - 1;

    while (i < j)
    {
        if (s[i] != '0' || s[j] != '0')
        {
            valid = 0;
            break;
        }
        i++;
        j--;
    }

    for (; i <= j; i++)
    {
        if (s[i] != '1')
            valid = 0;
    }

    if (valid)
        printf("String Accepted");
    else
        printf("String Rejected");

    return 0;
}
