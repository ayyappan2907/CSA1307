
#include <stdio.h>
#include <string.h>

int main()
{
    char s[100];
    int i, n, count0 = 0, count1 = 0;
    int valid = 1;

    printf("Enter a string: ");
    scanf("%99s", s);

    n = strlen(s);

    for (i = 0; i < n; i++)
    {
        if (s[i] == '0' && count1 == 0)
            count0++;
        else if (s[i] == '1')
            count1++;
        else
            valid = 0;
    }

    if (valid && count0 == count1)
        printf("String Accepted");
    else
        printf("String Rejected");

    return 0;
}
