#include <stdio.h>
#include <string.h>

int main()
{
    char str[100];
    int len;

    printf("Enter a string: ");
    scanf("%s", str);

    len = strlen(str);

    if (str[0] == 'a' && str[len - 1] == 'a')
        printf("String is ACCEPTED");
    else
        printf("String is REJECTED");

    return 0;
}
